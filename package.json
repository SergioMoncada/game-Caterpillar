{
  "name": "game-caterpillar",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply game-caterpillar-db --local",
    "db:migrate": "wrangler d1 migrations apply game-caterpillar-db --remote",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "typecheck": "tsc -p worker --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "typescript": "~6.0.2",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
