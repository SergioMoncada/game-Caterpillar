{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe llamarse igual que el Worker del panel de Cloudflare.
  "name": "game-caterpillar",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // El mismo Worker sirve el juego (frontend/dist) y la API.
  // Solo las rutas /api/* ejecutan codigo; lo demas son archivos estaticos.
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // SUPABASE_URL (texto) y SUPABASE_SECRET_KEY (secreto) se configuran en el panel:
  // Settings -> Variables and Secrets. keep_vars evita que cada deploy borre la URL.
  "keep_vars": true
}
