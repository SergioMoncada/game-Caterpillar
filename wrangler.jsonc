{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe llamarse igual que el Worker del panel de Cloudflare.
  "name": "game-caterpillar",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // El mismo Worker sirve el juego (frontend/dist) y la API.
  // Solo las rutas /api/* ejecutan codigo; lo demas son archivos estaticos.
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // La URL del proyecto Supabase es publica.
  // La clave secreta NO va aqui: se configura en el panel como secreto SUPABASE_SECRET_KEY.
  "vars": {
    "SUPABASE_URL": "https://befgnmxgmoypptbxcueh.supabase.co"
  }
}
